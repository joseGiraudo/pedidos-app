# Conexión pooled de Neon (con -pooler en el host). La usa la app en runtime.
DATABASE_URL=

# Conexión directa de Neon (sin pooler). La usa drizzle-kit para migraciones y studio.
DATABASE_URL_UNPOOLED=

# Better Auth: secreto para firmar sesiones y tokens. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base de la app (sin barra final). En local: http://localhost:3000
BETTER_AUTH_URL=
