# Copiar a .env.local y completar. Nunca commitear .env.local.

# Base de datos (Neon) — usar la rama dev en desarrollo
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Entrar con Google (Google Cloud Console → Credenciales → ID de cliente OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL pública de la app (para armar links de clientes y de WhatsApp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails (recuperación de contraseña)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@tu-dominio.com"
